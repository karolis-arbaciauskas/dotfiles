command = /bin/zsh -lc "exec herdr --session work"

theme = TokyoNight
font-size = 14
font-family = "JetBrains Mono"
font-style-bold = auto
font-style-italic = auto
font-style-bold-italic = auto
confirm-close-surface = false
cursor-style = block
cursor-style-blink = false
fullscreen = true
macos-option-as-alt = true
font-thicken = true
mouse-hide-while-typing = true

# Open new splits in the same directory
window-inherit-working-directory = true

# Close split
keybind = super+w=close_surface

# Cmd-k opens herdr-bar by sending Ctrl-Alt-k (CSI-u).
keybind = cmd+k=text:\x1b[107;7u
